# Runtime database connection for `next dev` / `prisma db push`.
# Tests do NOT use this — they boot their own embedded Postgres (see test/db.ts).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loyalty"

# WhatsApp BSP (issue #11). Leave unset to use the in-memory fake sender.
# Set the endpoint + ONE credential to switch to live sending.
#   - Cloud-API-direct style:  WHATSAPP_TOKEN (sent as "Authorization: Bearer ...")
#   - 360dialog-style BSP:     WHATSAPP_API_KEY (sent as "D360-API-KEY: ...")
# WHATSAPP_ENDPOINT="https://waba-v2.360dialog.io/messages"
# WHATSAPP_API_KEY=""
# WHATSAPP_TOKEN=""
